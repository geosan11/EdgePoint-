# EdgePoint+ Environment Variables Configuration

# Environment
ENVIRONMENT=development
DEBUG=True

# Ingestion & Polling Mode
# Set MOCK_MODE=False once you configure live API keys
MOCK_MODE=True
POLL_INTERVAL_MINUTES=15

# Supabase (Optional for local test, required for cloud sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Sports Odds & Match Data APIs
THE_ODDS_API_KEY=your_the_odds_api_key_here
API_FOOTBALL_KEY=your_api_football_key_here

# Quantitative Thresholds
MIN_EV_PERCENTAGE=3.0
MIN_EDGE_SCORE=70.0
KELLY_FRACTION=0.25
MAX_RECOMMENDED_UNITS=3.0
FREE_TIER_DAILY_PICKS=2

# API / CORS
# "*" is dev-only (no credentialed requests allowed). In production, set a real
# comma-separated origin list, e.g. https://app.edgepoint.plus,https://edgepoint.plus
ALLOWED_ORIGINS=*

# When set, /api/predictions and /api/parlay/daily require this value in the
# X-API-Key header to receive Pro-tier data. Leave unset for local/dev use.
INTERNAL_API_KEY=

# ML Model Blending (backend/ml_pipeline/) -- keep OFF until a model trained
# on real (non-synthetic) historical data has been validated out-of-sample.
ML_BLEND_ENABLED=False
ML_BLEND_WEIGHT=0.3
